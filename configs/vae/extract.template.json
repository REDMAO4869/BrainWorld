{
  "seed": 42,
  "device": "auto",
  "data": {
    "train": [
      "${DATA_ROOT}/splits/train.csv"
    ],
    "val": [
      "${DATA_ROOT}/splits/val.csv"
    ],
    "test": [
      "${DATA_ROOT}/splits/test.csv"
    ],
    "recursive": true,
    "extensions": [
      ".npy",
      ".npz"
    ],
    "layout": "DHWT",
    "t_frames": 40,
    "temporal_crop_train": "random",
    "temporal_crop_eval": "center",
    "normalize": "none",
    "train_subset_ratio": 1.0,
    "fg_threshold": 1e-06,
    "brain_mask_path": "",
    "audit_preview": 3,
    "bbox_crop": {
      "enabled": false
    },
    "skip_corrupt_files": true,
    "skip_corrupt_retry_limit": 64,
    "skip_corrupt_log_limit": 20,
    "precheck_corrupt_files": false
  },
  "model": {
    "in_channels": 1,
    "stage_channels": [
      16,
      32,
      64,
      96
    ],
    "latent_dim": 16,
    "res_blocks_per_stage": 2,
    "dropout": 0.0,
    "spatial_kernel_size": 5,
    "temporal_kernel_size": 5,
    "temporal_residual_scale": 0.1,
    "logvar_min": -6.0,
    "logvar_max": 4.0,
    "wavelet_fusion_enabled": true,
    "wavelet_energy_channels": 8,
    "wavelet_stages": [
      "enc2",
      "enc3",
      "dec1",
      "dec2"
    ],
    "num_spatial_downsamples": 3,
    "temporal_mode": "spatial_only",
    "spatial_only_frame_chunk_size": 0
  },
  "extraction": {
    "checkpoint": "${WEIGHTS_ROOT}/vae_checkpoint.pt",
    "auto_load_model_config": true,
    "split": "train",
    "batch_size": 1,
    "num_workers": 0,
    "max_samples": 0,
    "posterior_mode": "mu",
    "resume": true,
    "save_dtype": "float32",
    "output_dir": "${OUTPUT_ROOT}/vae_latents",
    "save_compressed": false,
    "save_fields": [
      "mu"
    ],
    "use_amp": false,
    "amp_dtype": "bf16",
    "gpu_ids": [],
    "use_timestamped_output": false
  }
}
