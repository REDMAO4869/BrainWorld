{
  "seed": 42,
  "device": "cuda",
  "amp": true,
  "manifest_paths": {
    "train": "../artifacts/manifests/train.jsonl",
    "val": "../artifacts/manifests/val.jsonl"
  },
  "data": {
    "image_key": "auto",
    "layout": "xyzt",
    "target_spatial_size": [
      96,
      96,
      96
    ],
    "target_num_frames": 40,
    "normalization": "zscore_nonzero",
    "skip_corrupt_files": true,
    "skip_corrupt_retry_limit": 64,
    "skip_corrupt_log_limit": 20
  },
  "loader": {
    "batch_size": 12,
    "num_workers": 4,
    "pin_memory": true,
    "persistent_workers": true,
    "drop_last": false
  },
  "model": {
    "spatial_dims": 3,
    "in_channels": 1,
    "out_channels": 1,
    "num_channels": [
      96,
      192
    ],
    "num_res_layers": 2,
    "num_res_channels": [
      96,
      192
    ],
    "downsample_parameters": [
      [
        2,
        4,
        1,
        1
      ],
      [
        2,
        4,
        1,
        1
      ]
    ],
    "upsample_parameters": [
      [
        2,
        4,
        1,
        1,
        0
      ],
      [
        2,
        4,
        1,
        1,
        0
      ]
    ],
    "num_embeddings": 1024,
    "embedding_dim": 4,
    "commitment_cost": 0.25,
    "decay": 0.99,
    "epsilon": 1e-05,
    "dropout": 0.0,
    "ddp_sync": false,
    "use_checkpointing": false
  },
  "optimizer": {
    "lr": 0.0001,
    "betas": [
      0.9,
      0.95
    ],
    "weight_decay": 0.0
  },
  "training": {
    "max_steps": 20000,
    "log_every": 20,
    "val_every": 5000,
    "save_every": 2000,
    "max_val_batches": 20,
    "recon_loss": "l1",
    "quantization_weight": 1.0,
    "use_ddp": false,
    "ddp_find_unused_parameters": false,
    "process_group_timeout_hours": 6.0
  },
  "warm_start": {
    "checkpoint_path": null,
    "strict": false
  },
  "output_dir": "../artifacts/stage1_vqvae",
  "visualization": {
    "enabled": true,
    "every_n_steps": 500,
    "num_samples": 4,
    "save_npz": true,
    "dpi": 130,
    "output_subdir": "visualizations/stage1_recon"
  }
}
